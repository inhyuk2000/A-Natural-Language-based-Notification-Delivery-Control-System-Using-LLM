OPENAI_API_KEY=your-openai-api-key
# optional
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=notillm-backend
# v1 = prompt_engine / v2 = LangGraph LLM router / v3 = embedding classifier + pending-first
PROMPT_ENGINE_VERSION=v1
# INTENT_CLASSIFIER=auto|heuristic  (v3; auto uses SentenceTransformer+LR when installed)
# INTENT_CLASSIFIER=heuristic
